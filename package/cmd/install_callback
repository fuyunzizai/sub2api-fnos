#!/bin/bash
set -u

APP_NAME="sub2api"
APP_SHARE="sub2api-docker"
IMAGE_TAG="sub2api-fnos:0.2.8"
APP_RUNTIME_VERSION="0.2.8"
PREBUILT_IMAGE="ghcr.nju.edu.cn/fuyunzizai/sub2api-fnos:0.2.8 ghcr.nju.edu.cn/fuyunzizai/sub2api-fnos:latest ghcr.io/fuyunzizai/sub2api-fnos:0.2.8 ghcr.io/fuyunzizai/sub2api-fnos:latest"

INSTALL_LOG="${SUB2API_INSTALL_LOG:-/tmp/sub2api-install.log}"
if : >> "${INSTALL_LOG}" 2>/dev/null; then
    printf '\n===== %s 安装开始 =====\n' "$(date '+%F %T' 2>/dev/null || echo now)" >> "${INSTALL_LOG}" 2>/dev/null
else
    INSTALL_LOG=""
fi

emit() {
    printf '%s\n' "$1"
    [ -n "${INSTALL_LOG}" ] && printf '%s\n' "$1" >> "${INSTALL_LOG}" 2>/dev/null
    return 0
}

log() {
    emit "[sub2api install] $*"
}

fail() {
    emit "[sub2api install] ERROR: $*"
    emit "[sub2api install] 日志文件: ${INSTALL_LOG:-<不可写>}"
    exit 1
}

# 飞牛只回一句“执行脚本出错且原因未知”，把每条失败命令的行号落到日志里便于定位。
set -E
trap 'rc=$?; emit "[sub2api install] command failed (rc=${rc}) at line ${LINENO}: ${BASH_COMMAND}"' ERR

compose_cmd() {
    if docker compose version >/dev/null 2>&1; then
        docker compose -p "${APP_NAME}" -f "${COMPOSE_FILE}" "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose -p "${APP_NAME}" -f "${COMPOSE_FILE}" "$@"
    else
        return 127
    fi
}

gen_secret() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex 32
    else
        tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64
        echo
    fi
}

detect_volume() {
    if [ -n "${TRIM_APPDEST_VOL:-}" ]; then
        printf '/%s\n' "${TRIM_APPDEST_VOL#/}"
        return 0
    fi
    if [ -n "${TRIM_APPDEST:-}" ]; then
        case "${TRIM_APPDEST}" in
            /vol*/*)
                printf '%s\n' "${TRIM_APPDEST%%/@*}"
                return 0
                ;;
        esac
    fi
    for candidate in /vol*/@appshare/"${APP_SHARE}" /vol*/@appcenter/"${APP_NAME}" /vol*/@appmeta/"${APP_NAME}"; do
        if [ -e "${candidate}" ]; then
            printf '%s\n' "${candidate%%/@*}"
            return 0
        fi
    done
    printf '/vol2\n'
}

APP_VOL="$(detect_volume)"
TRIM_APPDEST_VOL="${APP_VOL#/}"
export TRIM_APPDEST_VOL
DATA_ROOT="${APP_VOL}/@appshare/${APP_SHARE}"
ENV_FILE="${DATA_ROOT}/sub2api.env"

ensure_app_target_link() {
    appcenter_dir="${APP_VOL}/@appcenter/${APP_NAME}"
    var_app_dir="/var/apps/${APP_NAME}"
    target_path="${var_app_dir}/target"

    [ -d "${appcenter_dir}" ] || return 0
    mkdir -p "${var_app_dir}" 2>/dev/null || true

    if [ -L "${target_path}" ]; then
        current_target="$(readlink "${target_path}" 2>/dev/null || true)"
        [ "${current_target}" = "${appcenter_dir}" ] || ln -sfn "${appcenter_dir}" "${target_path}"
        return 0
    fi

    if [ ! -e "${target_path}" ]; then
        ln -s "${appcenter_dir}" "${target_path}" 2>/dev/null || true
        return 0
    fi

    if [ -d "${target_path}" ] && [ ! -f "${target_path}/docker/docker-compose.yaml" ]; then
        rmdir "${target_path}" 2>/dev/null && ln -s "${appcenter_dir}" "${target_path}" 2>/dev/null || true
    fi
}

read_env_value() {
    key="$1"
    [ -s "${ENV_FILE}" ] || return 1
    sed -n "s/^${key}=//p" "${ENV_FILE}" | head -n 1 | sed 's/^"//;s/"$//'
}

escape_env_value() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_env_line() {
    key="$1"
    value="$2"
    printf '%s="%s"\n' "$key" "$(escape_env_value "$value")"
}

detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64)
            printf 'amd64\n'
            ;;
        aarch64|arm64)
            printf 'arm64\n'
            ;;
        *)
            fail "unsupported architecture: $(uname -m)"
            ;;
    esac
}

download_file() {
    url="$1"
    dest="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -fL --connect-timeout 20 --max-time 300 --retry 3 --retry-delay 2 -o "${dest}" "${url}"
        return $?
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -O "${dest}" "${url}"
        return $?
    fi
    fail "curl or wget is required to download Sub2API runtime"
}

binary_version() {
    bin="$1"
    [ -x "${bin}" ] || return 1
    "${bin}" --version 2>/dev/null | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1
}

version_gt() {
    awk -v a="${1#v}" -v b="${2#v}" 'BEGIN {
        split(a, A, "."); split(b, B, ".");
        for (i = 1; i <= 3; i++) {
            ai = A[i] + 0; bi = B[i] + 0;
            if (ai > bi) exit 0;
            if (ai < bi) exit 1;
        }
        exit 1;
    }'
}

prepare_runtime_binary() {
    runtime_dir="${DATA_ROOT}/data/runtime"
    runtime_bin="${runtime_dir}/sub2api"
    mkdir -p "${runtime_dir}"

    current_version="$(binary_version "${runtime_bin}" || true)"
    if [ -n "${current_version}" ] && ! version_gt "${APP_RUNTIME_VERSION}" "${current_version}"; then
        log "runtime binary ${current_version} is already >= ${APP_RUNTIME_VERSION}"
        chmod 0755 "${runtime_bin}" 2>/dev/null || true
        return 0
    fi

    arch="$(detect_arch)"
    archive="sub2api_${APP_RUNTIME_VERSION}_linux_${arch}.tar.gz"
    base_url="https://github.com/Wei-Shaw/sub2api/releases/download/v${APP_RUNTIME_VERSION}"
    tmp_dir="$(mktemp -d)"
    log "downloading Sub2API runtime ${APP_RUNTIME_VERSION} for linux/${arch}"

    download_file "${base_url}/${archive}" "${tmp_dir}/${archive}" || {
        rm -rf "${tmp_dir}"
        log "WARNING: 无法从 GitHub 下载 ${archive}，跳过。容器首次启动会用镜像内的 /app/sub2api 自动补齐运行时二进制。"
        return 0
    }
    download_file "${base_url}/checksums.txt" "${tmp_dir}/checksums.txt" || {
        rm -rf "${tmp_dir}"
        log "WARNING: 无法下载 checksums.txt，跳过运行时二进制下载。"
        return 0
    }
    (cd "${tmp_dir}" && grep "${archive}" checksums.txt | sha256sum -c -) || {
        rm -rf "${tmp_dir}"
        log "WARNING: ${archive} 校验和不匹配，跳过运行时二进制下载。"
        return 0
    }
    tar -xzf "${tmp_dir}/${archive}" -C "${tmp_dir}" || {
        rm -rf "${tmp_dir}"
        log "WARNING: 解压 ${archive} 失败，跳过运行时二进制下载。"
        return 0
    }
    new_bin="$(find "${tmp_dir}" -type f -name sub2api | head -n 1)"
    [ -n "${new_bin}" ] || {
        rm -rf "${tmp_dir}"
        log "WARNING: ${archive} 内未找到 sub2api，跳过运行时二进制下载。"
        return 0
    }

    chmod 0755 "${new_bin}"
    if ! "${new_bin}" --version >/dev/null 2>&1; then
        rm -rf "${tmp_dir}"
        log "WARNING: 下载的 sub2api 二进制无法执行，跳过。"
        return 0
    fi
    cp "${new_bin}" "${runtime_bin}.new"
    chmod 0755 "${runtime_bin}.new"
    mv -f "${runtime_bin}.new" "${runtime_bin}"
    rm -rf "${tmp_dir}"
    log "prepared persistent runtime binary ${APP_RUNTIME_VERSION} at ${runtime_bin}"
}

find_docker_dir() {
    for candidate in \
        "${TRIM_APPDEST:-}/docker" \
        "$(cd "$(dirname "$0")" && pwd)/docker" \
        "$(cd "$(dirname "$0")" && pwd)/../app/docker" \
        "$(cd "$(dirname "$0")" && pwd)/../docker" \
        "${APP_VOL}/@appcenter/${APP_NAME}/docker" \
        "${APP_VOL}/@appmeta/${APP_NAME}/cmd/docker"
    do
        if [ -n "${candidate}" ] && [ -f "${candidate}/Dockerfile" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

find_compose_file() {
    script_dir="$(cd "$(dirname "$0")" && pwd)"

    for candidate in \
        "${TRIM_APPDEST:-}/docker/docker-compose.yaml" \
        "${script_dir}/docker/docker-compose.yaml" \
        "${script_dir}/../app/docker/docker-compose.yaml" \
        "${script_dir}/../docker/docker-compose.yaml" \
        "${APP_VOL}/@appcenter/${APP_NAME}/docker/docker-compose.yaml" \
        "${APP_VOL}/@appmeta/${APP_NAME}/cmd/docker/docker-compose.yaml" \
        /vol*/@appcenter/"${APP_NAME}"/docker/docker-compose.yaml \
        /vol*/@appmeta/"${APP_NAME}"/cmd/docker/docker-compose.yaml
    do
        if [ -f "${candidate}" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

build_local_image() {
    DOCKER_DIR="$(find_docker_dir)" || fail "Dockerfile not found"
    log "building image ${IMAGE_TAG} from ${DOCKER_DIR}"
    build_err_log="/tmp/sub2api-build-err.log"
    if docker build -t "${IMAGE_TAG}" "${DOCKER_DIR}" > "${build_err_log}" 2>&1; then
        return 0
    fi
    fail "本地构建 ${IMAGE_TAG} 失败，docker 报错(末尾): $(tail -n 5 "${build_err_log}" 2>/dev/null | tr '\n' ' | ')"
}

prepare_app_image() {
    if ! command -v docker >/dev/null 2>&1; then
        fail "docker command not found"
    fi

    docker rm -f "${APP_NAME}" "${APP_NAME}-redis" >/dev/null 2>&1 || true

    if docker image inspect "${IMAGE_TAG}" >/dev/null 2>&1; then
        log "using existing local image ${IMAGE_TAG}"
        return 0
    fi

    if [ -n "${PREBUILT_IMAGE}" ] && [ "${PREBUILT_IMAGE}" != "__SUB2API_FNOS_IMAGE__" ]; then
        pull_err_log="/tmp/sub2api-pull-err.log"
        for candidate in ${PREBUILT_IMAGE}; do
            log "pulling prebuilt image ${candidate}"
            if docker pull "${candidate}" > "${pull_err_log}" 2>&1 && docker tag "${candidate}" "${IMAGE_TAG}"; then
                log "prepared ${IMAGE_TAG} from ${candidate}"
                return 0
            fi
            log "拉取 ${candidate} 失败，docker 报错: $(tail -n 3 "${pull_err_log}" 2>/dev/null | tr '\n' ' | ')"
        done
        log "所有预构建镜像都拉取失败，回退到本地构建"
    fi

    build_local_image
}

start_app() {
    if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        fail "docker 不可用：请先在飞牛「Docker」中启用并确认 docker info 能正常返回"
    fi
    COMPOSE_FILE="$(find_compose_file)" || fail "找不到 docker-compose.yaml"
    compose_cmd up -d --remove-orphans || fail "启动 ${APP_NAME} 失败（compose 命令或镜像有问题）"
}

log "应用数据目录: ${DATA_ROOT}"
mkdir -p \
    "${DATA_ROOT}/data" \
    "${DATA_ROOT}/data/postgresql" \
    "${DATA_ROOT}/data/postgresql-run" \
    "${DATA_ROOT}/data/redis" \
    "${DATA_ROOT}/data/logs" || fail "无法创建数据目录 ${DATA_ROOT}（安装盘可能不可写）"
chmod 700 \
    "${DATA_ROOT}" \
    "${DATA_ROOT}/data" \
    "${DATA_ROOT}/data/postgresql" \
    "${DATA_ROOT}/data/postgresql-run" \
    "${DATA_ROOT}/data/redis" 2>/dev/null || true
touch "${DATA_ROOT}/.write-test" 2>/dev/null && rm -f "${DATA_ROOT}/.write-test" || fail "数据目录 ${DATA_ROOT} 不可写"

ensure_app_target_link

if [ -s "${ENV_FILE}" ]; then
    DATABASE_PASSWORD="$(read_env_value DATABASE_PASSWORD)"
    REDIS_PASSWORD="$(read_env_value REDIS_PASSWORD)"
    JWT_SECRET="$(read_env_value JWT_SECRET)"
    TOTP_ENCRYPTION_KEY="$(read_env_value TOTP_ENCRYPTION_KEY)"
    EXISTING_ADMIN_EMAIL="$(read_env_value ADMIN_EMAIL || true)"
    EXISTING_ADMIN_PASSWORD="$(read_env_value ADMIN_PASSWORD || true)"
else
    DATABASE_PASSWORD="$(gen_secret)"
    REDIS_PASSWORD="$(gen_secret)"
    JWT_SECRET="$(gen_secret)"
    TOTP_ENCRYPTION_KEY="$(gen_secret)"
    EXISTING_ADMIN_EMAIL=""
    EXISTING_ADMIN_PASSWORD=""
fi
[ -n "${DATABASE_PASSWORD:-}" ] || DATABASE_PASSWORD="$(gen_secret)"
[ -n "${REDIS_PASSWORD:-}" ] || REDIS_PASSWORD="$(gen_secret)"
[ -n "${JWT_SECRET:-}" ] || JWT_SECRET="$(gen_secret)"
[ -n "${TOTP_ENCRYPTION_KEY:-}" ] || TOTP_ENCRYPTION_KEY="$(gen_secret)"

ADMIN_EMAIL="${wizard_admin_email:-${EXISTING_ADMIN_EMAIL:-admin@52o.ink}}"
ADMIN_PASSWORD="${wizard_admin_password:-${EXISTING_ADMIN_PASSWORD:-}}"

[ -n "${ADMIN_EMAIL}" ] || fail "请填写管理员邮箱"
[ -n "${ADMIN_PASSWORD}" ] || fail "请填写管理员密码"

umask 077
{
    write_env_line DATABASE_HOST "127.0.0.1"
    write_env_line DATABASE_PORT "15432"
    write_env_line DATABASE_USER "sub2api_fnos"
    write_env_line DATABASE_PASSWORD "${DATABASE_PASSWORD}"
    write_env_line DATABASE_DBNAME "sub2api_fnos"
    write_env_line DATABASE_SSLMODE "disable"
    write_env_line DATABASE_MAX_OPEN_CONNS "50"
    write_env_line DATABASE_MAX_IDLE_CONNS "10"
    write_env_line DATABASE_CONN_MAX_LIFETIME_MINUTES "30"
    write_env_line DATABASE_CONN_MAX_IDLE_TIME_MINUTES "5"
    write_env_line POSTGRES_BIND "127.0.0.1"
    write_env_line POSTGRES_PORT "15432"
    write_env_line POSTGRES_DB "sub2api_fnos"
    write_env_line POSTGRES_USER "sub2api_fnos"
    write_env_line POSTGRES_PASSWORD "${DATABASE_PASSWORD}"
    write_env_line POSTGRES_DATA_DIR "/app/data/postgresql"
    write_env_line POSTGRES_RUN_DIR "/app/data/postgresql-run"
    write_env_line REDIS_HOST "127.0.0.1"
    write_env_line REDIS_PORT "16379"
    write_env_line REDIS_PASSWORD "${REDIS_PASSWORD}"
    write_env_line REDIS_DB "0"
    write_env_line REDIS_POOL_SIZE "1024"
    write_env_line REDIS_MIN_IDLE_CONNS "10"
    write_env_line REDIS_ENABLE_TLS "false"
    write_env_line REDIS_DATA_DIR "/app/data/redis"
    write_env_line SUB2API_WRITE_CONFIG "true"
    write_env_line ADMIN_EMAIL "${ADMIN_EMAIL}"
    write_env_line ADMIN_PASSWORD "${ADMIN_PASSWORD}"
    write_env_line JWT_SECRET "${JWT_SECRET}"
    write_env_line JWT_EXPIRE_HOUR "24"
    write_env_line TOTP_ENCRYPTION_KEY "${TOTP_ENCRYPTION_KEY}"
} > "${ENV_FILE}"
chmod 600 "${ENV_FILE}"

prepare_runtime_binary
prepare_app_image
log "prepared embedded PostgreSQL, Redis and application data in ${DATA_ROOT}"
start_app
log "started ${APP_NAME}"
log "安装完成。日志: ${INSTALL_LOG:-<不可写>}"
cp -f "${INSTALL_LOG}" "${DATA_ROOT}/install.log" 2>/dev/null || true
exit 0
